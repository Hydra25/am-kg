# ---- Local LLM (Ollama) --------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# For thinking models (qwen3.5, gemma4 ...) set false to turn off slow reasoning; leave empty for qwen2.5
OLLAMA_THINK=
# Optional embedding model for Chroma vector search (ollama pull nomic-embed-text)
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- Optional: cloud LLM instead of Ollama (OpenAI-compatible, free tiers) ---
# Default is local Ollama. To use a free cloud tier (faster, keeps the laptop cool):
#   LLM_PROVIDER=groq        # groq | cerebras | gemini | openrouter | lmstudio | openai_compat
#   LLM_MODEL=<model id from the provider's model list>
#   LLM_API_KEY=<your key>   # stays in this .env file only; .env is git-ignored
# Free tiers may keep your prompts: send only published papers.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# ---- Optional: automatic fallback chain (LLM_PROVIDER=fallback) ------------
# Free tiers are tried in this order; one that hits its rate limit / daily quota is
# paused and the next one answers. Local Ollama is always the last resort.
# Leave a pair empty to skip that provider. Find model names with:
#   python main.py check --list-models
GROQ_API_KEY=
GROQ_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ---- Neo4j (optional during early development) ---------------------------
# Leave NEO4J_URI empty to use the built-in local JSON graph store.
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# ---- Optional GROBID server for scientific PDF parsing -------------------
# e.g. http://localhost:8070 ; leave empty to use PyMuPDF only
GROBID_URL=

# ---- Pipeline overrides (optional; defaults live in config/settings.yaml) -
# EXTRACTION_MODE=auto        # auto | rule | gliner | llm | hybrid
# ENTITY_BACKEND=auto         # auto | gliner | llm | none
# LLM_CACHE=true              # false = always call the model
# GRAPH_BACKEND=auto          # auto | neo4j | local
# VECTOR_BACKEND=bm25         # bm25 | chroma
# AMKG_ACCEPT_THRESHOLD=0.85
# AMKG_REVIEW_THRESHOLD=0.60
# LOG_LEVEL=INFO
